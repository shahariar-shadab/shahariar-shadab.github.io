# ============================================================================
#  TEMPLATE — copy to .env (cp .env.example .env) and fill in. This file IS committed: keep it blank.
#  The real .env stays on your Mac. It is gitignored and NEVER uploaded to GitHub.
#
#  No quotes, no spaces around =.   Example:  PUBLIC_GITHUB_USERNAME=shahshadab
#
#  ⚠️  Keys starting with PUBLIC_ are written into the website (visible to everyone).
#      Keys WITHOUT PUBLIC_ are private — the website build never reads them.
# ============================================================================


# ---------------------------------------------------------------------------
#  1) GITHUB — needed to publish the site            ← fill these in now
# ---------------------------------------------------------------------------

# Your GitHub username (github.com/<this part>). Public: used for the site link.
PUBLIC_GITHUB_USERNAME=

# Name shown on your commits.
GIT_NAME=Shahariar Shadab

# Email for commits. Recommended: your private GitHub noreply address
# (GitHub → profile photo → Settings → Emails), looks like:
#   12345678+username@users.noreply.github.com
GIT_EMAIL=


# ---------------------------------------------------------------------------
#  2) SHOWN ON THE WEBSITE (contact section)
# ---------------------------------------------------------------------------

PUBLIC_EMAIL=
PUBLIC_LINKEDIN=https://www.linkedin.com/in/shahariar-shadab


# ---------------------------------------------------------------------------
#  3) LATER — optional extras (leave blank for now)
# ---------------------------------------------------------------------------

# Formspree form ID, e.g. xyzabcd (from https://formspree.io/f/xyzabcd).
# Blank = the contact form opens the visitor's email app instead.
PUBLIC_FORMSPREE_ID=

# Custom domain once you buy one, e.g. shahshadab.com.
# Blank = the site lives at https://<username>.github.io
PUBLIC_DOMAIN=


# ---------------------------------------------------------------------------
#  4) PRIVATE — never published anywhere
# ---------------------------------------------------------------------------

PHONE=
